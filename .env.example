# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or a local mongod)
MONGO_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/messanger_app

# Secret used to sign auth JWTs. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Aria, the in-app AI friend. Optional: with no working provider the app still
# runs and Aria replies with a "not configured" message instead of failing.
#   ollama    - a model running locally. Free, offline, no API key.
#   anthropic - the Claude API. Needs ANTHROPIC_API_KEY and credits.
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=
